{
  "name": "palestine-music-directory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run verify:export",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "import": "node --import tsx scripts/import.ts",
    "build:data": "node --import tsx scripts/build-public-export.ts",
    "review": "node --import tsx scripts/review.ts",
    "publish": "node --import tsx scripts/publish.ts",
    "withdraw": "node --import tsx scripts/withdraw.ts",
    "validate": "node --import tsx scripts/validate.ts",
    "status": "node --import tsx scripts/status.ts",
    "verify:export": "node --import tsx scripts/verify-export.ts"
  },
  "dependencies": {
    "astro": "^4.16.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
