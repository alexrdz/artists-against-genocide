---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadPublicExport } from '../../lib/load-export';
import type { Campaign } from '../../lib/schemas';

export function getStaticPaths() {
  const data = loadPublicExport();
  return data.campaigns.map(campaign => ({
    params: { slug: campaign.slug },
  }));
}

const data = loadPublicExport();
const { slug } = Astro.params;

const campaign = data.campaigns.find(c => c.slug === slug);

if (!campaign) {
  return Astro.redirect('/404');
}

const campaignArtists = data.artists
  .filter(a => a.campaignIds.includes(campaign.id))
  .sort((a, b) => a.sortKey.localeCompare(b.sortKey));

const categoryLabels: Record<string, string> = {
  'G-D': 'Direct anti-genocide',
  'G-C': 'Collective anti-genocide',
  'S': 'Solidarity / ceasefire',
  'H': 'Historical-only',
};
---

<BaseLayout title={`${campaign.name} — Palestine Music Directory`} description={campaign.description}>
  <div class="container" style="padding-top: var(--spacing-6); padding-bottom: var(--spacing-6)">
    <a href="/campaigns/" class="profile__back">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m15 18-6-6 6-6" />
      </svg>
      All campaigns
    </a>

    <div class="campaign-page__hero">
      <h1 class="campaign-page__name">{campaign.name}</h1>
      <p class="campaign-page__description">{campaign.description}</p>
      <a href={campaign.sourceUrl} target="_blank" rel="noopener noreferrer nofollow" class="campaign-page__source">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 3h6v6" />
          <path d="M10 14 21 3" />
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
        </svg>
        View original source
      </a>
    </div>

    <h2 style="margin-bottom: var(--spacing-4)">
      {campaignArtists.length} {campaignArtists.length === 1 ? 'artist' : 'artists'} in this campaign
    </h2>

    <div class="results__grid">
      {campaignArtists.map(a => (
        <a href={`/artists/${a.slug}/`} class="artist-card">
          <div class="artist-card__name">{a.name}</div>
          <div class="artist-card__badges">
            <span class={`cat-badge cat-badge--${a.tier}`}>{a.tier}</span>
          </div>
          <div class="artist-card__evidence-count">{a.evidence.length} evidence {a.evidence.length === 1 ? 'record' : 'records'}</div>
        </a>
      ))}
    </div>

    {campaignArtists.length === 0 && (
      <div class="empty-state">
        <div class="empty-state__title">No published artists in this campaign yet</div>
        <p>Artists may be pending review. Check back later.</p>
      </div>
    )}
  </div>
</BaseLayout>
