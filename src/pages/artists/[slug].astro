---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadPublicExport } from '../../lib/load-export';
import type { CanonicalArtist, Campaign } from '../../lib/schemas';

export function getStaticPaths() {
  const data = loadPublicExport();
  return data.artists.map(artist => ({
    params: { slug: artist.slug },
  }));
}

const data = loadPublicExport();
const { slug } = Astro.params;

const artist = data.artists.find(a => a.slug === slug);

if (!artist) {
  return Astro.redirect('/404');
}

const categoryLabels: Record<string, string> = {
  'G-D': 'Direct anti-genocide statement',
  'G-C': 'Collective anti-genocide statement or boycott',
  'S': 'Broader solidarity or ceasefire advocacy',
  'H': 'Historical-only solidarity',
};

const campaignMap = new Map<string, Campaign>(data.campaigns.map(c => [c.id, c]));

const artistCampaigns = artist.campaignIds
  .map(id => campaignMap.get(id))
  .filter((c): c is Campaign => c !== undefined);

// Related artists: share at least one campaign, exclude self, limit 5
const related = data.artists
  .filter(a => a.id !== artist.id && a.campaignIds.some(c => artist.campaignIds.includes(c)))
  .slice(0, 5);

const pageTitle = `${artist.name} — Palestine Music Directory`;
---

<BaseLayout title={pageTitle} description={`${artist.name}: ${categoryLabels[artist.tier]} — evidence and campaign associations.`}>
  <div class="layout-page profile">
    <div class="section-marker">
      <span>DOSSIER · ARTIST PROFILE</span>
      <span class="section-marker__meta">VERIFIED ARCHIVAL RECORD</span>
    </div>

    <div class="profile__header">
      <a href="/" class="profile__back">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m15 18-6-6 6-6" />
        </svg>
        <span>Back to directory</span>
      </a>
      <h1 class="profile__name">{artist.name}</h1>
      <div class="profile__badges">
        {artist.evidence.map(ev => (
          <span class={`cat-badge cat-badge--${ev.category}`}>{ev.category}</span>
        ))}
        {artistCampaigns.map(c => (
          <a href={`/campaigns/${c.slug}/`} class="campaign-badge">{c.name}</a>
        ))}
      </div>
    </div>

    <div class="profile__layout">
      <div class="profile__evidence" data-stack="gap:m">
        <h2 style="font-family: var(--font-display); font-size: var(--text-xl); color: var(--color-bone); margin-bottom: 0.5rem">
          Evidence ({artist.evidence.length})
        </h2>

        {artist.evidence.map(ev => (
          <div class={`evidence-card evidence-card--${ev.category}`}>
            <div class="evidence-card__category">
              <span class={`cat-badge cat-badge--${ev.category}`}>{ev.category}</span>
              <span style="font-family: var(--font-mono); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-ash)">
                {categoryLabels[ev.category]}
              </span>
            </div>
            <p class="evidence-card__summary">{ev.summary}</p>
            <div class="evidence-card__source">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
              </svg>
              <a href={ev.sourceUrl} target="_blank" rel="noopener noreferrer nofollow">{ev.sourceLabel}</a>
            </div>
          </div>
        ))}

        <div style="padding: 1.5rem; background: rgba(9, 9, 13, 0.6); border: 1px solid rgba(255, 255, 255, 0.08); font-size: var(--text-xs); color: var(--color-ash); line-height: 1.6;">
          <strong style="color: var(--color-bone);">Note:</strong> The research snapshot date ({data.researchSnapshotDate}) is not the date of a statement
          or a new source review. An organizer attribution is not independent authentication of every signature or
          identity. Absence from this directory does not establish silence or any political position.
        </div>
      </div>

      <aside class="sidebar" data-stack="gap:m">
        <div class="sidebar__card">
          <div class="sidebar__title">Campaigns ({artistCampaigns.length})</div>
          <div class="sidebar__list">
            {artistCampaigns.map(c => (
              <div class="sidebar__list-item">
                <a href={`/campaigns/${c.slug}/`}>{c.name}</a>
              </div>
            ))}
          </div>
        </div>

        {related.length > 0 && (
          <div class="sidebar__card">
            <div class="sidebar__title">Related artists</div>
            <div class="sidebar__list">
              {related.map(r => (
                <div class="sidebar__list-item">
                  <a href={`/artists/${r.slug}/`}>{r.name}</a>
                  <span class={`cat-badge cat-badge--${r.tier}`}>{r.tier}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        <div class="sidebar__card">
          <div class="sidebar__title">Profile metadata</div>
          <div class="sidebar__list">
            <div class="sidebar__list-item">
              <span>Tier</span>
              <span class={`cat-badge cat-badge--${artist.tier}`}>{artist.tier}</span>
            </div>
            <div class="sidebar__list-item">
              <span>Evidence records</span>
              <span style="font-family: var(--font-mono); color: var(--color-bone);">{artist.evidence.length}</span>
            </div>
            <div class="sidebar__list-item">
              <span>Imported</span>
              <span style="font-family: var(--font-mono); color: var(--color-bone);">{new Date(artist.importedAt).toLocaleDateString()}</span>
            </div>
            <div class="sidebar__list-item">
              <span>Reviewed</span>
              <span style="font-family: var(--font-mono); color: var(--color-bone);">{artist.reviewedAt ? new Date(artist.reviewedAt).toLocaleDateString() : '—'}</span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
