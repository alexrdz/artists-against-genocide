---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Palestine Music Directory',
  description = 'A directory of musicians who have made public statements against the genocide of Palestinians.',
} = Astro.props;

const navLinks = [
  { href: '/', label: 'Directory' },
  { href: '/campaigns', label: 'Campaigns' },
  { href: '/methodology', label: 'Methodology' },
  { href: '/changes', label: 'Changes' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a href="/" class="site-header__brand">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="site-header__brand-icon" aria-hidden="true">
            <circle cx="8" cy="18" r="4" />
            <path d="M12 18V2l7-3" />
            <path d="M8 18l3-3" />
          </svg>
          <span>Palestine Music Directory</span>
        </a>

        <nav class="site-header__nav" aria-label="Primary">
          {navLinks.map(link => (
            <a
              href={link.href}
              aria-current={currentPath === link.href ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))}
        </nav>

        <button
          class="site-header__menu-button"
          id="menu-toggle"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
        </button>
      </div>

      <nav
        class="site-header__mobile-nav"
        id="mobile-nav"
        aria-label="Mobile primary"
      >
        {navLinks.map(link => (
          <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
            {link.label}
          </a>
        ))}
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="site-footer__inner">
          <div>
            <div class="site-footer__brand">Palestine Music Directory</div>
            <p class="site-footer__tagline">
              A community-maintained directory of musicians who have made public statements
              against the genocide of Palestinians. Inclusion is documentation, not endorsement.
            </p>
          </div>
          <nav class="site-footer__nav" aria-label="Footer">
            {navLinks.map(link => (
              <a href={link.href}>{link.label}</a>
            ))}
          </nav>
        </div>
        <div class="site-footer__bottom">
          Research snapshot date is not the date of a statement or a new source review.
          Absence does not establish silence or any political position.
        </div>
      </div>
    </footer>

    <script>
      const menuToggle = document.getElementById('menu-toggle');
      const mobileNav = document.getElementById('mobile-nav');
      if (menuToggle && mobileNav) {
        menuToggle.addEventListener('click', () => {
          const isOpen = mobileNav.classList.toggle('is-open');
          menuToggle.setAttribute('aria-expanded', String(isOpen));
        });
      }
    </script>
  </body>
</html>
